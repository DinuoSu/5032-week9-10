rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.role == 'admin'; }
    function validBook() {
      return request.resource.data.keys().hasAll(['isbn', 'name'])
        && request.resource.data.keys().hasOnly(['isbn', 'name'])
        && request.resource.data.isbn is int
        && request.resource.data.isbn > 0
        && request.resource.data.isbn <= 9007199254740991
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.name.matches('.*[^\\s].*');
    }
    match /books/{bookId} {
      allow read: if signedIn();
      allow create: if signedIn() && validBook();
      allow update: if admin() && validBook();
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
