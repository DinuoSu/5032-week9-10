# Local emulators are the default; no cloud account is needed.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-fit5032
# Only fill these and disable emulator mode for a separately configured cloud app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
# Week 9: replace with the deployed URL later, or use the local Functions emulator.
VITE_COUNT_BOOKS_URL=http://127.0.0.1:5001/demo-fit5032/us-central1/countBooks
